{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/.well-known/agent-card.json", "destination": "/api/card" },
    { "source": "/.well-known/agent.json", "destination": "/api/card" },
    { "source": "/.well-known/agent-registration.json", "destination": "/api/registration" },
    { "source": "/a2a", "destination": "/api/a2a" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }
      ]
    }
  ],
  "functions":{ "api/**/*.ts": { "maxDuration": 120 } },
  "crons": [
    { "path": "/api/keeper", "schedule": "10 0 * * *" },
    { "path": "/api/sweep", "schedule": "20 0 * * *" }
  ]
}
